{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infertap.ai/schemas/inference-events/records.schema.json",
  "title": "Inference event records",
  "description": "Structural wire contract. Stream obligations are defined in spec/kv-cache-v2.md. Unknown fields are preserved for forward compatibility.",
  "oneOf": [
    {
      "$ref": "#/$defs/agent_start"
    },
    {
      "$ref": "#/$defs/agent_stop"
    },
    {
      "$ref": "#/$defs/clear"
    },
    {
      "$ref": "#/$defs/evict"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/holder_reset"
    },
    {
      "$ref": "#/$defs/identity_refused"
    },
    {
      "$ref": "#/$defs/segment_open"
    },
    {
      "$ref": "#/$defs/segment_recovered"
    },
    {
      "$ref": "#/$defs/segments_dropped"
    },
    {
      "$ref": "#/$defs/store"
    }
  ],
  "$defs": {
    "Endpoint": {
      "type": "object",
      "properties": {
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages known lost on this subscription."
        },
        "endpoint": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "Configured subscription endpoint."
        },
        "last_msg_at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "optional",
          "description": "Producer-clock timestamp of the last observed message, in milliseconds."
        },
        "msgs_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages observed on this subscription."
        },
        "publisher_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Sequence regressions observed on this subscription."
        },
        "source": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "Operator-defined source name for this subscription."
        },
        "topic": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "Configured subscription topic."
        }
      },
      "required": [
        "dropped",
        "endpoint",
        "msgs_seen",
        "source"
      ],
      "additionalProperties": true
    },
    "agent_start": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "agent_start",
          "description": "Record discriminator: `agent_start`."
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "Producer clock."
        },
        "agent_version": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "Producer version."
        },
        "egress": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "One of `pseudonymized` or `raw`. `raw` means identities are emitted unprotected and \u00a73's key-space rules do not apply."
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Subscriptions configured."
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Largest inbound engine message accepted."
        },
        "canary": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "conditional",
          "description": "Present when identities are keyed (\u00a73.4)."
        },
        "reuse_reporting": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "`none` \\| `labelled` \\| `unlabelled`; whether this producer's engine announces cache reuse as a `store`, and whether it can be told apart (\u00a72.3)."
        }
      },
      "required": [
        "kind",
        "at_ms",
        "agent_version",
        "egress",
        "endpoint_count",
        "max_payload_bytes"
      ],
      "additionalProperties": true,
      "x-section": "2.4",
      "allOf": [
        {
          "if": {
            "properties": {
              "egress": {
                "const": "pseudonymized"
              }
            },
            "required": [
              "egress"
            ]
          },
          "then": {
            "required": [
              "canary"
            ]
          }
        }
      ]
    },
    "agent_stop": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
