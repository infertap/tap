        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "The engine the regressed source observes (\u00a73.2)."
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
