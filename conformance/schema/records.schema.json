          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages observed on this subscription."
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages known lost on this subscription."
        },
        "oversized": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages refused for size."
        },
        "unknown_types": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Inbound messages of unmodelled type."
        },
        "events_ingested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Events that reached the record model."
        },
        "content_unresolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Records emitted with no `content_id`, one per omission (\u00a73.1)."
        },
        "content_bridge_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Identity-derivation state size (the producer's view of the resident set)."
        },
        "content_bridge_evicted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Identity promises refused at the declared capacity; nonzero means some evicts will not resolve, each window also declared via `identity_refused`."
        },
        "publisher_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "required",
          "description": "Sequence regressions observed on this subscription; the envelope's `publisher_restarts` is their sum, and `holder_reset` (\u00a72.3) is the record a reader acts on."
        },
        "reuse_reporting": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "`none` \\| `labelled` \\| `unlabelled`; whether this producer's engine announces cache reuse as a `store`, and whether it can be told apart (\u00a72.3)."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "x-column-type": "list<struct>",
          "x-presence": "required",
          "description": "Per-subscription statistics."
        },
        "canary": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "conditional",
          "description": "Present when identities are keyed (\u00a73.4)."
        }
      },
      "required": [
        "kind",
        "at_ms",
        "reason",
        "msgs_seen",
        "dropped",
        "oversized",
        "unknown_types",
        "events_ingested",
        "content_unresolved",
        "content_bridge_entries",
        "content_bridge_evicted",
        "publisher_restarts",
        "endpoints"
      ],
      "additionalProperties": true,
      "x-section": "2.4"
    },
    "clear": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "clear",
          "description": "Record discriminator: `clear`."
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
          "description": "Engine clock."
        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "The engine process holding this cache, named by the operator (\u00a73.2)."
        },
        "scope": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "What was cleared, for example `all`."
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "The data parallel worker the clear applies to; **absent means the wire declared none and the clear is global across workers** (\u00a73.2 and the note below)."
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Cache group affected by the clear. Omission applies the clear across all groups."
        },
        "tier": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "Storage tier the clear applied to; **absent means the clear is global across tiers**."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Transport sequence of the message that carried this event."
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "scope"
      ],
      "additionalProperties": true,
      "x-section": "2.3"
    },
    "evict": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
