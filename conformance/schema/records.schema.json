        },
        "instance_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "The engine process whose cache the block left (\u00a73.2)."
        },
        "block_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "description": "Engine-local identity (\u00a73.1), the same value its `store` carried."
        },
        "tier": {
          "type": [
            "string",
            "null"
          ],
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "Storage tier the block left. A block offloaded to another tier is evicted from the one it left."
        },
        "dp_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "The data parallel worker within that instance (\u00a73.2)."
        },
        "group_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "The cache group within that worker (\u00a73.2)."
        },
        "content_id": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "Portable identity (\u00a73.1), resolved from the producer\u2019s identity state."
        },
        "locality": {
          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "optional",
          "description": "`LOCAL` or `REMOTE`, relative to the publishing holder."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Transport sequence of the message that carried this event."
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-column-type": "int64",
          "x-presence": "optional",
          "description": "Pseudonymization key epoch."
        },
        "backend_id": {
          "type": "string",
          "description": "Optional engine-emitted backend identity, scoped to publisher incarnation, rank, group and tier. Pseudonymized at egress.",
          "x-column-type": "utf8",
          "x-presence": "optional"
        }
      },
      "required": [
        "kind",
        "at_ms",
        "instance_id",
        "block_id"
      ],
      "additionalProperties": true,
      "x-section": "2.3"
    },
