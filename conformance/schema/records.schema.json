          "type": "string",
          "x-column-type": "utf8",
          "x-presence": "required",
          "const": "holder_reset",
          "description": "Record discriminator: `holder_reset`."
        },
        "at_ms": {
          "type": "number",
          "x-column-type": "float64",
          "x-presence": "required",
