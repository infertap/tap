# Object-store destination and rclone authentication. See docs/install.md.
# Keep the trailing /kv/; the shipper appends UTC date, hour, and hostname.
# Use workload credentials where available.
INFERTAP_DEST=s3:acme-telemetry/infertap/prod-us-east/kv/

RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_ENV_AUTH=true
